    <section class="container-fluid padding_top_bottom bg-imag-help-us revealUp mt-4">
        <div class="row learning_part_2" style="padding-bottom:5rem; margin-bottom:7rem">
            <div class="col-md-4 col-lg-4">
                <div class="learning_part_1 energy-cal" id="form-page-before">
                    <h3 class="mb-3"><strong>Help us understand your energy needs</strong></h3>
                    <div class="flex">
                        <div class="mb-3 mt-3 d-inline w-48">
                            <p class="">Type of Usage </p>
                            <select name="usage" id="usage_id"
                                class="form-control col-sm-4 h-5 mr-5 choose_us_bg select_tag" onchange=getusage()>
                                <option value="7" selected>Residential</option>
                                <option value="10">Commerical</option>
                            </select>
                        </div>

                        <div class="mb-3 mt-3 d-inline w-48">
                            <p class="">Type of City </p>
                            <select name="usage" id="city_id" class="form-control col-sm-4 h-5 choose_us_bg select_tag"
                                onchange=getradiovalue()>
                                <option value="7" selected>Tier 1</option>
                                <option value="10">Tier 2</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <p class="mb-3">Average monthly electricity bill </p>
                        <div style="display:flex">
                            <div>
                                <p style="margin-bottom:0">Rupees</p>
                                <input oninput="getmonthlybill(this.value)" type="text"
                                    class="mr-2 form-control col-sm-4 h-5 choose_us_bg" id="e-bill" name="e-bill"
                                    style="min-width:100px">
                            </div>
                            <div id="unit_charges">
                                <p style="margin-bottom:0">Units</p>
                                <input type="hidden" id="total_units" name="total_units"
                                    class="form-control col-sm-4 h-5 choose_us_bg" disabled style="min-width:100px">
                            </div>
                            <div style="margin-top:30px" id="units_edit"></div>
                        </div>
                    </div><br /><br />
                    <div class="mb-3 mt-3">
                        <p>Your bill amount will help us calculate your energy consumptions and recommened right system
                            for your energy needs</p>
                    </div>
                    <div>
                        <button onclick=getshowmysystem() class="btn card-text-third" id="invalid_e_bill">Show my
                            system</button>
                    </div>
                </div>
            </div>
            <div class="col-md-8 col-lg-8">
            <div class="card-body" id="consumption-div-tag-before">
                    <h1 class="card-text" style="margin-top:5rem;">Power-One solar service</h1>
                    <p class="card-text-in">Find the right size for your home or commercial site installed by India’s
                        no. 1 solar inverter manufacturer</p>
                </div>
            </div>
            <div class="col-md-12 col-lg-12" id="calculator-result-wrap">
            <div class="col-md-4 col-lg-4">
                    <div class="learning_part_1 p-4 energy-cal" id="form-page-after">
                        <p class="mb-3 mt-3">Average monthly electricity bill: Rs. <b id="monthly_amount_display">1500</b>
                        </p>
                        <p class="mb-3 mt-3">Energy consumption: <b id="energy_consumption_display">1764</b>
                            <b>units/month</b>
                        </p>
                        <p class='mb-3 mt-3' onclick=getchangedetails()><u class='choose_us_bg_edit'>Change details</u></p>
                        <br />
                        <div class='mb-3 mt-3'>
                            <button data-toggle="modal" data-target="#exampleModal" class="btn card-text-third">Interested?
                                connect with us</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-8 col-lg-8">
                <div class="card-body" id="consumption-div-tag-after">
                    <h2 class="card-text" style="color:#222; font-size:1.3rem">For your energy needs, we recommend</h2>
                    <div class="card" style="border: none;">
                        <div class="col-sm-12 energy_div">
                            <div class="col-sm-6 choose_us_bg_fotter">
                                <img src="./img/home/product_fotter.svg" style="width:100px" alt="product"><br />
                                <span>Mono Perc Panels with 25 year warranty</span><br />
                                <span><b id="kilowath"></b> KW - Approximately <b id="nv_number">10</b> Solar
                                    Panels</span>
                            </div>
                            <div class="col-sm-3 choose_us_bg_fotter">
                                <img src="./img/home/payback.svg" alt="payback" style="min-height:67px"><br />
                                <span>Payback Period</span><br />
                                <span><b id="paybackyear">7</b> Years</span>
                            </div>
                            <div class="col-sm-3 choose_us_bg_fotter">
                                <img src="./img/home/total_cost.svg" alt="total cost" style="min-height:67px"><br />
                                <span>Total Cost</span><br />
                                <span>Approx. Rs. <b id="totalcost">7</b></span>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </section>
