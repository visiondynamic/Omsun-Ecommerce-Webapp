    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-vertical-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Enter details below to connect</h3>
                <button type="button" class="close" onclick="$('#exampleModal').modal('hide'); $('.modal-backdrop').removeClass('modal-backdrop'); $('.fade').removeClass('fade'); $('.in').removeClass('in');" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body section_padding">
            <form id="contactFormUser" method="post">
                <div class="form-group">
                    <input type="text" id="user_name" class="form-control" placeholder="Name" onInput="myFunctionNameUser(this.value)">
                    <span id="invalid_name" class="invaild_cls"></span>
                </div>
                <div class="form-group">
                    <input type="text" id="user_mobile" class="form-control" placeholder="Mobile Number" onkeyup="myFunctionMobileuser(this.value)">
                    <span id="invalid_phone" class="invaild_cls"></span>
                </div>
                <div class="form-group">
                    <input type="email" id="user_email" class="form-control" placeholder="Email Id" onInput="myFunctionNameEmail(this.value)">
                    <span id="invalid_email" class="invaild_cls"></span>
                </div>
                <div class="form-group" id="firm_input">
                    <input type="text" id="user_firm_name" class="form-control" placeholder="Firm Name">
                    <span id="invalid_firm_name" class="invaild_cls"></span>
                </div>
                <button type="submit" class="btn card-text-blue-inner-page" id="btn_disabled">Submit</button>
            </form>
            </div>
        </div>
    </div>
</div>
<script>
    //calling email changes
    function myFunctionNameEmail(str){
        /* mail parameter format */
        var mailformat = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;

        /* checking the condition for mail  */
        if(!str.match(mailformat)){
            $("#invalid_email").text("Please Enter Valid Email ID");
        }else{
            $("#invalid_email").text("");
        }
        /* Checking for all condition for user name,mobile,email
        reading value from id */
        var emailval = $("#user_email").val();
        var mobileval = $("#user_mobile").val();
        var username = $("#user_name").val();        
        
        //checking the condition
        if(emailval == "" || mobileval == "" || username == "" || !emailval.match(mailformat) || !($.isNumeric(mobileval)) || mobileval.length < 10 || mobileval.length > 10){
            $("#btn_disabled").prop('disabled',true);
        }else{
            $("#btn_disabled").prop('disabled',false);
        }
    }

    //calling name changes
    function myFunctionNameUser(str){
        if(str == ""){
            $("#invalid_name").text("Please Enter name");
        }else{
            $("#invalid_name").text("");
        }

        /* mail parameter format */
        var mailformat = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;

        /* reading value from id */
        var emailval = $("#user_email").val();
        var mobileval = $("#user_mobile").val();
        var username = $("#user_name").val();        
        
        //checking the condition
        if(emailval == "" || mobileval == "" || username == "" || !emailval.match(mailformat) || !($.isNumeric(mobileval)) || mobileval.length < 10 || mobileval.length > 10){
            $("#btn_disabled").prop('disabled',true);
        }else{
            $("#btn_disabled").prop('disabled',false);
        }
    }

    
    //calling mobile changes
    function myFunctionMobileuser(str){
        if(!($.isNumeric(str))){
            $("#invalid_phone").text("Mobile Number must be number");
        }else if(str == ""){
            $("#invalid_phone").text("Please Enter Mobile Number");
        }else if(str.length < 10 || str.length > 10){
            $("#invalid_phone").text("Mobile Number Must be 10 Digits");
        }else{
            $("#invalid_phone").text("");
        }

        /* mail parameter format */
        var mailformat = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;

        /* reading value from id */
        var emailval = $("#user_email").val();
        var mobileval = $("#user_mobile").val();
        var username = $("#user_name").val();        
        
        //checking the condition
        if(emailval == "" || mobileval == "" || username == "" || !emailval.match(mailformat) || !($.isNumeric(mobileval)) || mobileval.length < 10 || mobileval.length > 10){
            $("#btn_disabled").prop('disabled',true);
        }else{
            $("#btn_disabled").prop('disabled',false);
        }
    }

    //calling on user click on submit button
    $("#contactFormUser").submit(function (event) {
        event.preventDefault();

        /* mail parameter format */
        var mailformat = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;

        /* checking the condition for validation */
        if($("#user_name").val() == ""){
            $("#invalid_name").text("Please Enter name");
        }else if(!($.isNumeric($("#user_mobile").val())) || $("#user_mobile").val() == ""){
            $("#invalid_phone").text("Please Enter Valid Mobile Number");
        }else if($("#user_mobile").val().length != 10){
            $("#invalid_phone").text("Mobile Number Must be 10 Digits");
        }else if(!$("#user_email").val().match(mailformat)){
            $("#invalid_email").text("Please Enter Valid Email ID");
        }if($("#user_firm_name").val() == ""){
            $("#invalid_firm_name").text("Please Enter name");
        }else{

            /* set validation text empty */
            $("#invalid_name").text("");
            $("#invalid_phone").text("");
            $("#invalid_email").text("");
            $("#invalid_firm_name").text("");

            /* sertting the post parameter */
            var formData = {
                email: $("#user_email").val(),
                mobile_number: $("#user_mobile").val(),
                user_name: $("#user_name").val(),
                modal_type: "normal",
                firm_name: $("#user_firm_name").val()
            };

            /* ajax call */
            $.ajax({
                type: "POST",
                url: "send-mail.php",
                data: formData,
                success:function(data){
                    if(data == "success"){
                        //sweetalert for success msg on user submit details
                        swal({title: "Thank you for getting in touch! With Power-One", text: "", type: "success",timer: 3000},
                        function(){ 
                            $(".modal").modal("hide"); // closes all active pop ups.
                            //$(".modal-backdrop").remove(); // removes the grey overlay.
                            $('.modal-backdrop').removeClass('modal-backdrop'); // removes the grey overlay.
                            $('.fade').removeClass('fade'); // removes the grey overlay.
                            $('.in').removeClass('in'); // removes the grey overlay.
                            swal.close();
                        });
                    }
                    //reseting values to empty on popup
                    $("#user_name").val(""); 
                    $("#user_mobile").val("");
                    $("#user_email").val("");
                    $("#btn_disabled").prop('disabled',true);
                }
            });
        }
    });
</script></body>
<script>
//onchnage of type
function getusage() {
    var usage_type = $("#usage_id").val();
    var e_bill = $("#e-bill").val();
    var citites = $("#city_id").val();

    if (usage_type === "10") {
        $("#firm_input").css("display", "block");
    }

    /* calcualtion as per excel sheet for residential & commerical & tier_1 city & tier_2 city 
    please find the excel PV Calculator sheet simple calculator */
    var perce = (citites * usage_type) / 100;
    var addi = parseFloat(usage_type) + parseFloat(perce);
    var total_unit = parseFloat(parseFloat(e_bill) / parseFloat(addi)).toFixed(2);

    //checking value is there or not if not NAN then only show div
    if (!isNaN(total_unit)) {
        $("#unit_charges").css("display", "block");
        $("#total_units").val(total_unit);
        $("#total_units").prop('type', 'text');
        $("#units_edit").html(
            "<span onclick=getenableeditunit()><u class='choose_us_bg_edit'>Click to Edit Units</u></span>");
    }
}

//onchnage of citites
function getradiovalue() {
    var usage_type = $("#usage_id").val();
    var e_bill = $("#e-bill").val();
    var citites = $("#city_id").val();

    /* calcualtion as per excel sheet for residential & commerical & tier_1 city & tier_2 city 
    please find the excel PV Calculator sheet simple calculator */
    var perce = (citites * usage_type) / 100;
    var addi = parseFloat(usage_type) + parseFloat(perce);
    var total_unit = parseFloat(parseFloat(e_bill) / parseFloat(addi)).toFixed(2);

    //checking value is there or not if not NAN then only show div
    if (!isNaN(total_unit)) {
        $("#unit_charges").css("display", "block");
        $("#total_units").val(total_unit);
        $("#total_units").prop('type', 'text');
        $("#units_edit").html(
            "<span onclick=getenableeditunit()><u class='choose_us_bg_edit'>Click to Edit Units</u></span>");
    }
}

//onfocusout of monthly bill
function getmonthlybill(str) {
    var val = str.replace(/[^0-9.]/g, '').replace(/(\..*?)\..*/g, '$1');
    $("#e-bill").val(val);
    if (val == "") {
        $("#invalid_e_bill").prop('disabled', true);
        $("#invalid_e_bill").css('background-color', '#c7c7c7');

        $("#unit_charges").css("display", "none");
        $("#total_units").prop('type', 'hidden');
        $("#total_units").val('');
        $("#units_edit").html("");
    } else {
        $("#invalid_e_bill").prop('disabled', false);
        $("#invalid_e_bill").css('background-color', '#E71205');

        var usage_type = $("#usage_id").val();
        var e_bill = $("#e-bill").val();
        var citites = $("#city_id").val();

        /* calcualtion as per excel sheet for residential & commerical & tier_1 city & tier_2 city 
        please find the excel PV Calculator sheet simple calculator */
        var perce = (citites * usage_type) / 100;
        var addi = parseFloat(usage_type) + parseFloat(perce);
        var total_unit = parseFloat(parseFloat(e_bill) / parseFloat(addi)).toFixed(2);

        //checking value is there or not if not NAN then only show div
        if (!isNaN(total_unit)) {
            $("#unit_charges").css("display", "block");
            $("#total_units").val(total_unit);
            $("#total_units").prop('type', 'text');
            $("#units_edit").html(
                "<span onclick=getenableeditunit()><u class='choose_us_bg_edit'>Click to Edit Units</u></span>"
            );
        }
    }

}

//onclick of edit units
function getenableeditunit() {
    $("#total_units").prop('disabled', false);
}

//onclick show my system
function getshowmysystem() {
    var total_cost = $("#total_units").val();
    var e_bill = $("#e-bill").val();
    if (total_cost == "" || e_bill == "") {
        $("#invalid_e_bill").prop('disabled', true);
        $("#invalid_e_bill").css('background-color', '#c7c7c7');
    } else {
        //finding PV Size,number total cost as per excel sheet
        var kw = parseFloat(total_cost) / parseFloat(4.86 * 30);
        var pvnumber = parseFloat(kw) / parseFloat(500 / 1000);
        var kwround = parseInt(kw);
        var pvnumberround = Math.ceil(pvnumber);

        //final cost calculation
        var finalcost = parseInt(kwround) * parseInt(80000);

        //payback period calculation
        var yearcal = parseInt(e_bill) * parseInt(12);
        var finalyear = parseInt(parseInt(finalcost) / parseInt(yearcal));
        if (finalyear <= 1) {
            finalyear = "0 - 1";
        } else {
            finalyear = (finalyear - 1) + " - " + finalyear;
        }

        //assiging value to div
        $("#kilowath").text(kwround);
        $("#nv_number").text(pvnumberround);
        $("#paybackyear").text(finalyear);
        $("#totalcost").text(finalcost);

        if (parseInt(total_cost) < 150) {
            $("#exampleModal2").modal('show');
            $("#exampleModal2").addClass('in');
            $("#consumption-div-tag-before").css("display", "block");
            $("#consumption-div-tag-after").css("display", "none");

            //for helpus energy calculation page
            $("#form-page-before").css("display", "block");
            $("#form-page-after").css("display", "none");
        } else {
            $("#consumption-div-tag-before").css("display", "none");
            $("#consumption-div-tag-after").css("display", "block");
            $("#calculator-result-wrap").css("background-color", "#FFFFFF");
            //for helpus energy calculation page
            $("#form-page-before").css("display", "none");
            $("#form-page-after").css("display", "block");

            $("#monthly_amount_display").text(e_bill);
            $("#energy_consumption_display").text(total_cost);
        }
    }
}

//onload page
$(window).on("load", function() {
    $("#consumption-div-tag-before").css("display", "block");
    $("#consumption-div-tag-after").css("display", "none");

    //for helpus energy calculation page
    $("#form-page-before").css("display", "block");
    $("#form-page-after").css("display", "none");

    $("#unit_charges").css("display", "none");
    $(".display_reward").css("display", "none");
    $(".display_reward_outer").css("display", "block");
    $("#firm_input").css("display", "none");
});

//onclick change details
function getchangedetails() {
    /* setting the values to empty and disableing the button based ion id */
    $("#total_units").val("");
    $("#e-bill").val("");
    $("#invalid_e_bill").prop('disabled', true);
    $("#invalid_e_bill").css('background-color', '#c7c7c7');

    $("#consumption-div-tag-before").css("display", "block");
    $("#consumption-div-tag-after").css("display", "none");

    //for helpus energy calculation page
    $("#form-page-before").css("display", "block");
    $("#form-page-after").css("display", "none");

    $("#unit_charges").css("display", "none");
    $("#total_units").prop('type', 'hidden');
    $("#units_edit").html("");
}
</script>

</html>