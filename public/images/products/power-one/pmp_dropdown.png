            <div class="slick-list draggable display_reward_outer carousel-width" tabindex="0">
                <div class="slick-track" style="opacity: 1; width: 100%; transform: translate3d(0px, 0px, 0px);">
                    <div id="myCarouseldown" class="carousel slide slick-slide slick-active" data-ride="carousel"
